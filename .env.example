# Settings the app reads from the environment. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Shared password for the team. Required online; optional on your own computer.
TEAM_PASSWORD=choose-a-long-password

# Added automatically when you connect "Upstash for Redis" in Vercel → Storage.
# Leave unset on your own computer to keep using the data/ folder.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: if set, only Vercel Cron (which sends this secret) can trigger the
# daily price refresh.
# CRON_SECRET=
